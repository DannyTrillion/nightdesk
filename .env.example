# Robinhood Chain (Arbitrum Orbit L2, gas paid in ETH)
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_CHAIN_ID=46630
RH_MAINNET_CHAIN_ID=4663

# Deployer / attestor key - TESTNET BURNER ONLY.
# Never put the prize wallet's key here.
PRIVATE_KEY=

# Deployed MarketStateOracle, set after `forge create`
MARKET_STATE_ADDRESS=

# Agent
ANTHROPIC_API_KEY=
WATCH_INTERVAL_MINUTES=15
